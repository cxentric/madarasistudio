# ---------------------------------------------------------------------------
# Copy this file to .env.local for local dev, and add the same keys under
# Vercel → Project → Settings → Environment Variables for production.
# See README.md for step-by-step instructions on getting each value.
# ---------------------------------------------------------------------------

# Base URL of the deployed site (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# Random secret used to sign session tokens — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Database (Postgres) — powers accounts, sessions & phone OTP storage ---
# Works with Vercel Postgres, Neon, or Supabase connection strings.
DATABASE_URL=

# --- Google sign-in (Google Cloud Console → APIs & Services → Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple sign-in (Apple Developer → Certificates, Identifiers & Profiles) ---
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Email sign-in (magic link, sent via SMTP — Resend, Postmark, etc.) ---
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Madarasi Studio <hello@madarasistudio.com>"

# --- Phone sign-in (OTP delivery via Twilio Verify) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- AI ordering assistant (Anthropic API) ---
ANTHROPIC_API_KEY=

# --- Payments (Razorpay — swap for Stripe if you ship outside India) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
